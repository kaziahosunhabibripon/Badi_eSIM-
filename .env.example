APP_NAME=Badi eSIM Support API
APP_VERSION=1.0.0
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/badi_support

PORT = 8000

# Comma-separated list of frontend origins allowed to call this API (CORS). Defaults to
# the Vite dev server if unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# When true, GET /users/demo lists the seeded users with no authentication, so a UI can
# offer a "who am I" picker instead of asking for X-User-Id by hand. Set to false for
# anything beyond local development.
DEMO_MODE=true